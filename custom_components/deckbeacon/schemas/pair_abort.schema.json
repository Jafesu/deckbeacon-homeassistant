{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deckbeacon.invalid/protocol/v1/pair_abort.schema.json",
  "title": "pair_abort (either direction): pairing cancelled",
  "type": "object",
  "required": [
    "reason"
  ],
  "additionalProperties": false,
  "properties": {
    "reason": {
      "enum": [
        "sas_rejected",
        "timeout",
        "window_closed",
        "already_paired",
        "user_cancelled",
        "protocol_error"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 256
    }
  }
}
