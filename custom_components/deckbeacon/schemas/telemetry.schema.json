{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.deckbeacon.invalid/protocol/v1/telemetry.schema.json",
  "title": "telemetry (agent → HA): batch of metric samples with provenance",
  "type": "object",
  "required": ["metrics"],
  "additionalProperties": false,
  "properties": {
    "metrics": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["key", "value", "sampled_at", "source"],
        "additionalProperties": false,
        "properties": {
          "key": {"$ref": "common.schema.json#/$defs/key"},
          "value": {"description": "null = not available right now (see 'reason'); never a cached value", "type": ["number", "string", "boolean", "null"]},
          "unit": {"$ref": "common.schema.json#/$defs/short_text"},
          "sampled_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "source": {"$ref": "common.schema.json#/$defs/short_text"},
          "confidence": {"$ref": "common.schema.json#/$defs/confidence"},
          "reason": {"type": "string", "maxLength": 256}
        }
      }
    }
  }
}
